* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: #050505;
  color: #ffffff;
  line-height: 1.6;
}

a {
  text-decoration: none;
  color: inherit;
}


/* Header */

.header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 75px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 8%;

  background: rgba(5, 5, 5, 0.92);
  backdrop-filter: blur(12px);

  border-bottom: 1px solid #222;

  z-index: 1000;
}

.logo {
  font-size: 27px;
  font-weight: 800;
  letter-spacing: 1px;
}

.logo span {
  color: #ff1744;
}

nav {
  display: flex;
  gap: 30px;
}

nav a {
  color: #ddd;
  font-weight: 600;
  transition: 0.3s;
}

nav a:hover {
  color: #ff1744;
}

.menu-btn {
  display: none;
  background: none;
  border: none;
  color: white;
  font-size: 30px;
}


/* Hero */

.hero {
  min-height: 100vh;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 50px;

  padding: 120px 8% 80px;

  background:
    radial-gradient(circle at 80% 30%, #8b001f 0%, transparent 30%),
    radial-gradient(circle at 20% 80%, #30000b 0%, transparent 30%),
    #050505;
}

.hero-content {
  max-width: 650px;
}

.badge {
  display: inline-block;

  padding: 8px 15px;
  margin-bottom: 20px;

  border: 1px solid #ff1744;
  border-radius: 30px;

  color: #ff1744;
  font-size: 12px;
  font-weight: bold;
  letter-spacing: 2px;
}

.hero h1 {
  font-size: clamp(55px, 9vw, 100px);
  line-height: 1;
  margin-bottom: 25px;
}

.hero h1 span {
  color: #ff1744;
}

.hero p {
  max-width: 550px;
  color: #aaa;
  font-size: 18px;
  margin-bottom: 35px;
}

.buttons {
  display: flex;
  gap: 15px;
  flex-wrap: wrap;
}

.btn {
  padding: 14px 25px;
  border-radius: 8px;
  font-weight: bold;
  transition: 0.3s;
}

.primary {
  background: #ff1744;
  color: white;
}

.primary:hover {
  background: #d50032;
  transform: translateY(-3px);
}

.secondary {
  border: 1px solid #555;
}

.secondary:hover {
  border-color: #ff1744;
  color: #ff1744;
}


/* Hero Card */

.hero-card {
  width: 330px;

  padding: 45px 25px;

  text-align: center;

  background: linear-gradient(145deg, #161616, #090909);

  border: 1px solid #292929;
  border-radius: 25px;

  box-shadow: 0 20px 60px rgba(255, 23, 68, 0.15);
}

.circle {
  width: 170px;
  height: 170px;

  margin: auto;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #ff1744;

  font-size: 55px;
  font-weight: 900;

  box-shadow:
    0 0 0 10px #240009,
    0 0 60px rgba(255, 23, 68, 0.5);
}

.hero-card h2 {
  margin-top: 30px;
  font-size: 28px;
}

.hero-card p {
  margin: 5px 0 0;
  font-size: 14px;
}


/* Sections */

.section {
  padding: 100px 8%;
  background: #080808;
}

.section:nth-child(even) {
  background: #050505;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 15px;

  margin-bottom: 45px;
}

.section-title span {
  color: #ff1744;
  font-weight: bold;
}

.section-title h2 {
  font-size: 42px;
}


/* About */

.about-card {
  display: grid;
  grid-template-columns: 180px 1fr;

  gap: 40px;

  max-width: 900px;

  padding: 40px;

  background: #101010;

  border: 1px solid #222;
  border-radius: 20px;
}

.about-icon {
  width: 160px;
  height: 160px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 20px;

  background: linear-gradient(135deg, #ff1744, #70001c);

  font-size: 45px;
  font-weight: 900;
}

.about-card h3 {
  font-size: 30px;
  margin-bottom: 10px;
}

.about-card p {
  color: #aaa;
}

.info {
  display: flex;
  gap: 30px;
  flex-wrap: wrap;

  margin-top: 25px;
}

.info div {
  display: flex;
  flex-direction: column;
}

.info strong {
  color: #ff1744;
  font-size: 11px;
}

.info span {
  color: #ddd;
}


/* Gallery */

.gallery {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.gallery-box {
  height: 250px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 18px;

  background:
    linear-gradient(135deg, #25000a, #151515);

  border: 1px solid #292929;

  transition: 0.4s;
}

.gallery-box span {
  font-size: 60px;
  font-weight: 900;
  color: #ff1744;
}

.gallery-box:hover {
  transform: translateY(-8px);
  border-color: #ff1744;
  box-shadow: 0 15px 40px rgba(255, 23, 68, 0.2);
}


/* Contact */

.contact-card {
  max-width: 800px;

  padding: 45px;

  text-align: center;

  background: #101010;

  border: 1px solid #242424;
  border-radius: 20px;
}

.contact-card h3 {
  font-size: 32px;
  margin-bottom: 10px;
}

.contact-card p {
  color: #aaa;
  margin-bottom: 30px;
}

.social {
  display: flex;
  justify-content: center;
  gap: 15px;
  flex-wrap: wrap;
}

.social a {
  padding: 12px 22px;

  border: 1px solid #333;
  border-radius: 8px;

  transition: 0.3s;
}

.social a:hover {
  background: #ff1744;
  border-color: #ff1744;
}


/* Footer */

footer {
  padding: 40px 20px;

  text-align: center;

  background: #030303;

  border-top: 1px solid #222;
}

.footer-logo {
  font-size: 25px;
  font-weight: bold;
  margin-bottom: 10px;
}

.footer-logo span {
  color: #ff1744;
}

footer p {
  color: #777;
  font-size: 13px;
}


/* Mobile */

@media (max-width: 800px) {

  .header {
    padding: 0 6%;
  }

  .menu-btn {
    display: block;
  }

  nav {
    display: none;

    position: absolute;
    top: 75px;
    left: 0;

    width: 100%;

    flex-direction: column;

    padding: 25px;

    background: #080808;

    border-bottom: 1px solid #222;
  }

  nav.active {
    display: flex;
  }

  .hero {
    flex-direction: column;
    text-align: center;
    padding-top: 140px;
  }

  .hero p {
    margin-left: auto;
    margin-right: auto;
  }

  .buttons {
    justify-content: center;
  }

  .hero-card {
    width: 100%;
    max-width: 330px;
  }

  .section {
    padding: 75px 6%;
  }

  .section-title h2 {
    font-size: 32px;
  }

  .about-card {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .about-icon {
    margin: auto;
  }

  .info {
    justify-content: center;
  }

  .gallery {
    grid-template-columns: 1fr;
  }

  .gallery-box {
    height: 220px;
  }

  .contact-card {
    padding: 30px 20px;
  }
}